# Port server backend
PORT=4000

# Rahasia untuk menandatangani token login (JWT). Ganti dengan string acak yang panjang.
JWT_SECRET=ganti-dengan-string-rahasia-yang-panjang-dan-acak

# URL dasar aplikasi (dipakai di dalam link verifikasi email)
APP_BASE_URL=http://localhost:4000

# --- Pengaturan email verifikasi (opsional saat development) ---
# Jika SMTP_HOST kosong, link verifikasi akan otomatis dicetak di console
# server sehingga kamu tetap bisa mencoba fitur ini tanpa email sungguhan.
# Contoh pakai Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=email kamu, SMTP_PASS=App Password (bukan password biasa).
# Bisa juga pakai layanan seperti Resend, Mailtrap, atau SendGrid SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KarierKu <no-reply@karierku.app>"

# --- Sumber lowongan eksternal (opsional) ---
# Diaktifkan memakai API publik Remotive (tidak butuh API key) sebagai contoh.
# Set ke "false" untuk mematikan pencarian lowongan eksternal.
ENABLE_EXTERNAL_JOBS=true
